@page "/projects"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<JffAgentDbContext> DbFactory
@inject IGitHubCli GitHub
@inject IJSRuntime JS
<PageTitle>Projects</PageTitle><h1>Projects</h1>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @alertClass">@message</div> }
<div class="card mb-4"><div class="card-body"><h5>Add project</h5><EditForm Model="form" OnValidSubmit="AddAsync"><DataAnnotationsValidator/><div class="row g-2"><div class="col-md-4"><label class="form-label">Repository</label><InputSelect class="form-select" @bind-Value="form.RepositoryUrl"><option value="">Select a repository</option>@foreach (var repo in repositories) { <option value="@repo.Url">@repo.NameWithOwner</option> }</InputSelect></div><div class="col-md-3"><label class="form-label">Name</label><InputText class="form-control" @bind-Value="form.Name" /></div><div class="col-md-3"><label class="form-label">Local path</label><InputText class="form-control" @bind-Value="form.LocalPath" /></div><div class="col-md-2 align-self-end"><button class="btn btn-primary" disabled="@busy">Add and clone</button></div></div></EditForm><button class="btn btn-link px-0" @onclick="LoadRepositoriesAsync">Refresh GitHub repositories</button></div></div>
<table class="table table-striped"><thead><tr><th>Name</th><th>Repository</th><th>Local path</th><th></th></tr></thead><tbody>@foreach (var item in projects) { <tr><td>@item.Name</td><td><a href="@item.RepositoryUrl" target="_blank">@item.RepositoryUrl</a></td><td>@item.LocalPath</td><td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item.Id)">Delete</button></td></tr> }</tbody></table>
@code {
    List<Project> projects = []; List<GitHubRepositoryDto> repositories = []; ProjectForm form = new(); string? message; string alertClass = "alert-info"; bool busy;
    protected override async Task OnInitializedAsync() { await RefreshAsync(); await LoadRepositoriesAsync(); }
    async Task RefreshAsync() { await using var db = await DbFactory.CreateDbContextAsync(); projects = await db.Projects.OrderBy(x => x.Name).ToListAsync(); }
    async Task LoadRepositoriesAsync() { var result = await GitHub.ListRepositoriesAsync(); if (result.Success) repositories = result.Value ?? []; else Show(result.Error ?? "Could not load GitHub repositories.", false); }
    async Task AddAsync() { busy = true; try { var path = Path.IsPathRooted(form.LocalPath) ? form.LocalPath : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "jff-agent-runner", "git-repositories", form.LocalPath); Directory.CreateDirectory(Path.GetDirectoryName(path)!); if (Directory.Exists(path) && Directory.EnumerateFileSystemEntries(path).Any()) { Show("The target directory must be empty.", false); return; } var clone = await GitHub.CloneRepositoryAsync(form.RepositoryUrl, path); if (!clone.Success) { Show(clone.Error ?? "Clone failed.", false); return; } await using var db = await DbFactory.CreateDbContextAsync(); db.Projects.Add(new Project { Name = form.Name, RepositoryUrl = form.RepositoryUrl, LocalPath = path, CreatedAt = DateTime.UtcNow }); await db.SaveChangesAsync(); form = new(); await RefreshAsync(); Show("Project added.", true); } catch (Exception ex) { Show(ex.Message, false); } finally { busy = false; } }
    async Task DeleteAsync(int id) { var item = projects.First(p => p.Id == id); if (!await JS.InvokeAsync<bool>("confirm", $"Delete project {item.Name}?")) return; await using var db = await DbFactory.CreateDbContextAsync(); if (await db.Executions.AnyAsync(e => e.ProjectId == id)) { Show("This project has executions and cannot be deleted.", false); return; } var tracked = await db.Projects.FindAsync(id); if (tracked != null) { db.Remove(tracked); await db.SaveChangesAsync(); await RefreshAsync(); } }
    void Show(string text, bool ok) { message = text; alertClass = ok ? "alert-success" : "alert-danger"; }
    class ProjectForm { [System.ComponentModel.DataAnnotations.Required] public string RepositoryUrl { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string Name { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string LocalPath { get; set; } = ""; }
}
