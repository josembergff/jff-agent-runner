@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<JffAgentDbContext> DbFactory
<PageTitle>Dashboard</PageTitle><h1>Dashboard</h1>
<div class="row g-3 mt-2"><div class="col-md-4"><div class="card"><div class="card-body"><h5>Projects</h5><strong>@projectCount</strong></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><h5>Agents</h5><strong>@agentCount</strong></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><h5>Running or pending</h5><strong>@activeCount</strong></div></div></div></div>
@code { int projectCount, agentCount, activeCount; protected override async Task OnInitializedAsync() { await using var db = await DbFactory.CreateDbContextAsync(); projectCount = await db.Projects.CountAsync(); agentCount = await db.Agents.CountAsync(); activeCount = await db.Executions.CountAsync(e => e.Status == ExecutionStatusEnum.Running || e.Status == ExecutionStatusEnum.Pending); } }
