@page "/agents"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<JffAgentDbContext> DbFactory
@inject IJSRuntime JS
<PageTitle>Agents</PageTitle><h1>Agents</h1>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert alert-info">@message</div> }
<div class="card mb-4"><div class="card-body"><h5>Add agent</h5><EditForm Model="form" OnValidSubmit="AddAsync"><DataAnnotationsValidator/><div class="row g-2"><div class="col-md-3"><label class="form-label">Name</label><InputText class="form-control" @bind-Value="form.Name" /></div><div class="col-md-3"><label class="form-label">Command</label><InputText class="form-control" @bind-Value="form.Command" /></div><div class="col-md-4"><label class="form-label">Arguments (optional)</label><InputText class="form-control" @bind-Value="form.Arguments" /></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">Add agent</button></div></div></EditForm></div></div>
<table class="table table-striped"><thead><tr><th>ID</th><th>Name</th><th>Command</th><th>Arguments</th><th></th></tr></thead><tbody>@foreach (var agent in agents) { <tr><td>@agent.Id</td><td>@agent.Name</td><td>@agent.Command</td><td>@agent.Arguments</td><td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(agent.Id)">Delete</button></td></tr> }</tbody></table>
@code { List<Agent> agents = []; AgentForm form = new(); string? message; protected override async Task OnInitializedAsync() => await RefreshAsync(); async Task RefreshAsync() { await using var db = await DbFactory.CreateDbContextAsync(); agents = await db.Agents.OrderBy(a => a.Name).ToListAsync(); } async Task AddAsync() { await using var db = await DbFactory.CreateDbContextAsync(); db.Agents.Add(new Agent { Name = form.Name, Command = form.Command, Arguments = form.Arguments, CreatedAt = DateTime.UtcNow }); await db.SaveChangesAsync(); form = new(); await RefreshAsync(); message = "Agent added."; } async Task DeleteAsync(int id) { var selected = agents.First(a => a.Id == id); if (!await JS.InvokeAsync<bool>("confirm", $"Delete agent {selected.Name}?")) return; await using var db = await DbFactory.CreateDbContextAsync(); if (await db.Executions.AnyAsync(e => e.AgentId == id)) { message = "This agent has executions and cannot be deleted."; return; } var agent = await db.Agents.FindAsync(id); if (agent != null) { db.Remove(agent); await db.SaveChangesAsync(); await RefreshAsync(); } } class AgentForm { [System.ComponentModel.DataAnnotations.Required] public string Name { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string Command { get; set; } = ""; public string Arguments { get; set; } = ""; } }
