@page "/executions"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<JffAgentDbContext> DbFactory
@inject IGitHubCli GitHub
@inject IExecutionService ExecutionService
@inject ITmuxExecutor Tmux
@inject IJSRuntime JS
<PageTitle>Executions</PageTitle><h1>Executions</h1>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @alertClass">@message</div> }
<div class="card mb-4"><div class="card-body"><h5>Add execution</h5><div class="row g-2"><div class="col-md-3"><label class="form-label">Project</label><InputSelect class="form-select" @bind-Value="selectedProjectId" @bind-Value:after="ProjectChangedAsync"><option value="0">Select project</option>@foreach (var p in projects) { <option value="@p.Id">@p.Name</option> }</InputSelect></div><div class="col-md-3"><label class="form-label">Agent</label><InputSelect class="form-select" @bind-Value="selectedAgentId"><option value="0">Select agent</option>@foreach (var a in agents) { <option value="@a.Id">@a.Name</option> }</InputSelect></div><div class="col-md-4"><label class="form-label">Issue (open and Ready)</label><InputSelect class="form-select" @bind-Value="selectedIssueNumber" @bind-Value:after="OnIssueChanged"><option value="0">Select issue</option>@foreach (var issue in issues) { <option value="@issue.Number">#@issue.Number — @issue.Title</option> }</InputSelect></div><div class="col-md-2 align-self-end"><button class="btn btn-primary" @onclick="CreateAsync" disabled="@busy">Start</button></div></div>
    @if (selectedIssue is not null) { <div class="border rounded p-3 mt-3"><h6>Issue #@selectedIssue.Number: @selectedIssue.Title</h6><p class="mb-1" style="white-space:pre-wrap">@selectedIssue.Body</p><small>@selectedIssue.State · <a href="@selectedIssue.Url" target="_blank">Open on GitHub</a></small></div> }
</div></div>
<div class="row mb-3"><div class="col-md-3"><label class="form-label">Filter</label><InputSelect class="form-select" @bind-Value="filter" @bind-Value:after="RefreshAsync"><option value="all">All executions</option><option value="running">Running executions</option></InputSelect></div><div class="col-md-3"><label class="form-label">By agent</label><InputSelect class="form-select" @bind-Value="agentFilter" @bind-Value:after="RefreshAsync"><option value="0">All agents</option>@foreach (var a in agents) { <option value="@a.Id">@a.Name</option> }</InputSelect></div><div class="col-md-3"><label class="form-label">By project</label><InputSelect class="form-select" @bind-Value="projectFilter" @bind-Value:after="RefreshAsync"><option value="0">All projects</option>@foreach (var p in projects) { <option value="@p.Id">@p.Name</option> }</InputSelect></div></div>
<table class="table table-striped"><thead><tr><th>ID</th><th>Project</th><th>Agent</th><th>Issue</th><th>Status</th><th>Session</th><th>Details</th><th>Actions</th></tr></thead><tbody>@foreach (var e in executions) { <tr><td>@e.Id</td><td>@e.Project?.Name</td><td>@e.Agent?.Name</td><td><a href="https://github.com/@RepositorySlug(e.Project?.RepositoryUrl)/issues/@e.IssueNumber" target="_blank">#@e.IssueNumber</a></td><td>@e.Status</td><td>@e.SessionName</td><td>@e.SessionDetails</td><td class="text-nowrap"><button class="btn btn-sm btn-outline-secondary" @onclick="() => ViewAsync(e)">View running</button> @if (e.Status == ExecutionStatusEnum.Running) { <button class="btn btn-sm btn-outline-warning" @onclick="() => CancelAsync(e)">Cancel</button> } @if (e.Status != ExecutionStatusEnum.Running && e.Status != ExecutionStatusEnum.Pending) { <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(e)">Delete</button> }</td></tr> }</tbody></table>
@if (!string.IsNullOrEmpty(output)) { <div class="card mt-3"><div class="card-header">Session output</div><pre class="card-body mb-0" style="max-height:480px;overflow:auto;white-space:pre-wrap">@output</pre></div> }
@code {
    List<Project> projects = []; List<Agent> agents = []; List<Execution> executions = []; List<GitHubIssueDto> issues = []; GitHubIssueDto? selectedIssue;
    int selectedProjectId, selectedAgentId, selectedIssueNumber, agentFilter, projectFilter; string filter = "all"; string? message, output; string alertClass = "alert-info"; bool busy;
    protected override async Task OnInitializedAsync() { await using var db = await DbFactory.CreateDbContextAsync(); projects = await db.Projects.OrderBy(p => p.Name).ToListAsync(); agents = await db.Agents.OrderBy(a => a.Name).ToListAsync(); await RefreshAsync(); }
    async Task ProjectChangedAsync() { issues = []; selectedIssueNumber = 0; selectedIssue = null; var project = projects.FirstOrDefault(p => p.Id == selectedProjectId); if (project is null) return; var result = await GitHub.ListOpenIssuesAsync(project.RepositoryUrl); if (result.Success) issues = result.Value ?? []; else Show(result.Error ?? "Could not load issues.", false); }
    void OnIssueChanged() => selectedIssue = issues.FirstOrDefault(i => i.Number == selectedIssueNumber);
    async Task CreateAsync() { if (selectedProjectId == 0 || selectedAgentId == 0 || selectedIssueNumber == 0) { Show("Select a project, agent and issue.", false); return; } busy = true; try { var result = await ExecutionService.CreateAsync(new Execution { ProjectId = selectedProjectId, AgentId = selectedAgentId, IssueNumber = selectedIssueNumber, Status = ExecutionStatusEnum.Pending }); Show(result.Success ? "Execution started." : result.Error ?? "Execution failed.", result.Success); await RefreshAsync(); } catch (Exception ex) { Show(ex.Message, false); } finally { busy = false; } }
    async Task RefreshAsync() { await using var db = await DbFactory.CreateDbContextAsync(); var query = db.Executions.Include(e => e.Project).Include(e => e.Agent).AsQueryable(); if (filter == "running") query = query.Where(e => e.Status == ExecutionStatusEnum.Running); if (agentFilter != 0) query = query.Where(e => e.AgentId == agentFilter); if (projectFilter != 0) query = query.Where(e => e.ProjectId == projectFilter); executions = await query.OrderByDescending(e => e.Id).ToListAsync(); }
    async Task ViewAsync(Execution e) { if (e.Status != ExecutionStatusEnum.Running && e.Status != ExecutionStatusEnum.Pending) { Show("This execution is not running.", false); return; } var has = await Tmux.HasSessionAsync(e.SessionName); if (!has.Success) { Show(has.Error ?? "Could not check session.", false); return; } if (!has.Value) { Show("The tmux session is closed.", false); return; } var result = await Tmux.GetOutputAsync(e.SessionName); if (result.Success) output = result.Value; else Show(result.Error ?? "Could not retrieve output.", false); }
    async Task CancelAsync(Execution e) { if (!await JS.InvokeAsync<bool>("confirm", "Do you want to cancel this execution?")) return; await using var db = await DbFactory.CreateDbContextAsync(); var item = await db.Executions.FindAsync(e.Id); if (item is null) return; item.Status = ExecutionStatusEnum.Cancelled; item.UpdatedAt = DateTime.UtcNow; await db.SaveChangesAsync(); Show("Execution marked as cancelled.", true); await RefreshAsync(); }
    async Task DeleteAsync(Execution e) { if (!await JS.InvokeAsync<bool>("confirm", "Permanently delete this execution?")) return; await using var db = await DbFactory.CreateDbContextAsync(); var item = await db.Executions.FindAsync(e.Id); if (item is not null) { db.Executions.Remove(item); await db.SaveChangesAsync(); await RefreshAsync(); } }
    void Show(string text, bool ok) { message = text; alertClass = ok ? "alert-success" : "alert-danger"; }
    string RepositorySlug(string? url) => string.IsNullOrWhiteSpace(url) ? "" : string.Join('/', url.TrimEnd('/').Split('/').TakeLast(2)).Replace(".git", "");
}
